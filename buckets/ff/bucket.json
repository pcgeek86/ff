# ff
# A terminal-based file finder.
#
# Licensed under the MIT license.

# This bucket is for the "ff" project.
# It provides a tool for quickly finding files.

# Dependencies:
# None

[bucket]
name = "ff"
version = "0.1.0"
description = "A terminal-based file finder."
homepage = "https://github.com/pcgeek86/ff"
license = "MIT"
source = "https://github.com/pcgeek86/ff"

# Installation instructions for scoop
# Since it's a Rust project, we build it using cargo.
# For simplicity in this example, we assume it's already built or can be built easily.
# A better way would be using --build.

[build]
# For a real bucket, we'd use --build. 
# Here we show a basic structure.
build = "cargo build --release"

[files]
# List of files to include in the installation
# This is a placeholder for the real installation files.
# Usually, you'd use --bin or --dir.

# Here we use a simple approach of moving the binary to the scoop bin folder.
[install]
# This is where the installation logic goes.
# In a real setup, you'd use a more complex script or --bin.
# For this demonstration, we'll just assume the bin will be in target/release.
bin = "target/release/ff.exe"
